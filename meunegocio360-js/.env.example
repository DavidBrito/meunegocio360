# Variaveis PUBLICAS do frontend (VITE_*): nunca coloque segredos aqui (RNF-FE-10).
# Copie para .env.local.

# URL base da API: relativa (mesma origem, RNF-103). Em dev o proxy do Vite repassa /api ao backend.
VITE_API_BASE_URL=/api/v1

# Opcional (somente servidor de desenvolvimento): destino do proxy de /api. Padrao: http://localhost:8080
# API_PROXY_TARGET=http://localhost:8080
