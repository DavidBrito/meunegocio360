# Copie para .env (nunca versionado) e preencha os valores marcados com <...>.
# Nao coloque segredos reais neste arquivo (RNF-005, RNF-022).

# --- Ambiente: dev | test | prod (OBRIGATORIO: sem APP_ENV o backend nao inicia) ---
APP_ENV=dev
# Porta do backend (RNF-101)
PORT=8080

# --- Banco (PostgreSQL do Nucleo) ---
# Usado pelo compose.yaml para criar o banco e pelo backend para conectar.
DB_NAME=meunegocio360_core
DB_USER=meunegocio360
DB_PASSWORD=<senha-do-banco>
# URL sem credenciais; usuario e senha vem de DB_USER e DB_PASSWORD.
DB_URL=postgresql+psycopg://localhost:5432/meunegocio360_core

# --- Autenticacao (RF-BE-001) ---
# Segredo HS256 com pelo menos 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=<segredo-jwt-com-32-bytes-ou-mais>
# Origens permitidas (CORS e verificacao de Origin em /auth/refresh e /auth/logout), separadas por virgula.
# 5173 = frontend (Vite); 8080 = Swagger UI do proprio backend (/docs).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# false somente em dev, para testar por HTTP local. Em producao DEVE ser true.
APP_AUTH_COOKIE_SECURE=false
# Opcionais (valores padrao abaixo)
# APP_AUTH_MAX_TENTATIVAS=5
# APP_AUTH_BLOQUEIO_MINUTOS=15
# APP_AUTH_JWT_EXPIRACAO_MINUTOS=15
# APP_AUTH_REFRESH_EXPIRACAO_DIAS=7

# --- Seed de desenvolvimento (somente APP_ENV=dev; 8 a 72 caracteres) ---
SEED_ADMIN_SENHA=<senha-do-admin>
# SEED_USUARIO_SENHA e a senha do OPERADOR_COMERCIAL; SEED_FINANCEIRO_SENHA, do OPERADOR_FINANCEIRO.
SEED_USUARIO_SENHA=<senha-do-operador-comercial>
SEED_FINANCEIRO_SENHA=<senha-do-operador-financeiro>

# --- Tarefas agendadas (limpeza de refresh tokens, ADR 0004) ---
SCHEDULER_ENABLED=true
